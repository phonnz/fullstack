<.site_header current_user={assigns[:current_user]} />
<main id="main-content" tabindex="-1" class="px-4 py-8 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-xl">
    <.flash_group flash={@flash} />
  </div>
  <.header>
    <.icon name="hero-box-solid" aria-hidden="true" /> <%= @page_title %>
    <:actions>
      <.link patch={~p"/admin/devices/new"}>
        <.button>New Device</.button>
      </.link>
    </:actions>
  </.header>
  <%= @inner_content %>
</main>
