<!DOCTYPE html>
<html lang="en" class="[scrollbar-gutter:stable]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title suffix=" · Phoenix Framework">
      {assigns[:page_title] || "Fullstack"}
    </.live_title>
    <%!--
      Resolve the theme before first paint. Setting it from LiveView instead
      would flash the wrong theme on every load while the socket connects.
      localStorage throws outright in some privacy modes, hence the try/catch.
    --%>
    <script>
      try {
        var saved = localStorage.getItem("theme");
        var sys = window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.dataset.theme = saved || (sys ? "dark" : "light");
      } catch (_) {
        document.documentElement.dataset.theme = "light";
      }
    </script>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
  </head>
  <body class="bg-base-100 text-base-content antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:top-2 focus:left-2 focus:rounded-lg focus:bg-primary focus:px-4 focus:py-2 focus:text-primary-content focus:font-semibold focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-base-content"
    >
      Skip to main content
    </a>
    {@inner_content}
  </body>
</html>
